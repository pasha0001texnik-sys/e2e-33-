# Supabase (Settings → API). Ключ service_role — только на сервере воркера.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Опционально
# WORKER_ID=worker-1
# WORKER_MAX_RUNS=1          # сколько прогонов воркер ведёт одновременно
# WORKER_PLATFORMS=web       # web и/или android,ios (мобильные стенды через Appium)
# POLL_INTERVAL_MS=3000
# HEADLESS=true
# ENABLE_SCHEDULER=true      # cron-расписания
# ENABLE_JANITOR=true        # TTL, зависшие прогоны, очистка фикстур
# HOLD_TIMEOUT_SEC=900       # сколько ждать решения в manual_hold
# TRACE_MODE=on-failure      # off | on-failure | on
# BROWSER_EXECUTABLE_PATH=   # свой Chrome вместо браузера из образа
