# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Только сервер (Vercel → Environment Variables, без NEXT_PUBLIC_)
# Нужен для вебхука CI и больше нигде
SUPABASE_SERVICE_ROLE_KEY=
# Общий секрет для подписи вебхука из CI: openssl rand -hex 32
CI_WEBHOOK_SECRET=
